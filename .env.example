# Google Maps Platform
# Use a browser-restricted key for NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# Use a server-restricted key for GOOGLE_MAPS_SERVER_API_KEY in production.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Backward-compatible server alias. GOOGLE_MAPS_SERVER_API_KEY takes precedence.
GOOGLE_PLACES_API_KEY=

# Optional server APIs
GOOGLE_MAPS_GEOCODING_API_KEY=
GOOGLE_MAPS_GEOLOCATION_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
